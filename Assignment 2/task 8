import nltk
import math
from collections import Counter

nltk.download('averaged_perceptron_tagger_eng')
nltk.download('punkt_tab')

corpus = [
    "hello i need appointment",
    "i need doctor",
    "where is hospital",
    "doctor is available today",
    "please tell consultation fee"
]

tagged_data = []

for sentence in corpus:
    words = nltk.word_tokenize(sentence)
    tagged_data.append(nltk.pos_tag(words))

transition = Counter()
emission = Counter()
tag_count = Counter()

for sentence in tagged_data:
    previous = "<START>"

    for word, tag in sentence:
        transition[(previous, tag)] += 1
        emission[(tag, word.lower())] += 1
        tag_count[tag] += 1
        previous = tag

tags = list(tag_count.keys())

def viterbi(words):
    dp = [{}]
    back = [{}]

    for tag in tags:
        trans = (transition[("<START>", tag)] + 1) / (
            sum(transition[("<START>", t)] for t in tags) + len(tags)
        )

        emit = (emission[(tag, words[0].lower())] + 1) / (
            tag_count[tag] + len(emission)
        )

        dp[0][tag] = math.log(trans) + math.log(emit)
        back[0][tag] = None

    for i in range(1, len(words)):
        dp.append({})
        back.append({})

        for tag in tags:
            emission_prob = (emission[(tag, words[i].lower())] + 1) / (
                tag_count[tag] + len(emission)
            )

            best_score = float("-inf")
            best_previous = None

            for prev in tags:
                denominator = sum(
                    transition[(prev, t)] for t in tags
                ) + len(tags)

                transition_prob = (
                    transition[(prev, tag)] + 1
                ) / denominator

                score = (
                    dp[i-1][prev]
                    + math.log(transition_prob)
                    + math.log(emission_prob)
                )

                if score > best_score:
                    best_score = score
                    best_previous = prev

            dp[i][tag] = best_score
            back[i][tag] = best_previous

    best_tag = max(dp[-1], key=dp[-1].get)

    sequence = [best_tag]

    for i in range(len(words)-1, 0, -1):
        sequence.append(back[i][sequence[-1]])

    return list(reversed(sequence))

test = ["i", "need", "doctor", "appointment", "today"]

print("Input:", test)
print("Viterbi POS Tags:", viterbi(test))
