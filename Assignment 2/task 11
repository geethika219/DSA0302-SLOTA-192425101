import nltk
from collections import Counter
import math

nltk.download('averaged_perceptron_tagger_eng')
nltk.download('punkt_tab')

corpus = [
    "hello i need appointment",
    "i need doctor",
    "where is hospital",
    "doctor is available today",
    "please tell consultation fee"
]

tagged_data = []

for sentence in corpus:
    words = nltk.word_tokenize(sentence)
    tagged_data.append(nltk.pos_tag(words))

# POS tagging accuracy on the same annotated sample
# This is a demonstration, not held-out accuracy.

correct = 0
total = 0

for sentence in tagged_data:
    words = [word for word, tag in sentence]
    predicted = nltk.pos_tag(words)

    for actual, prediction in zip(sentence, predicted):
        total += 1

        if actual[1] == prediction[1]:
            correct += 1

accuracy = correct / total

print("POS Tagging Accuracy:", accuracy * 100)

# Language model comparison

results = {
    "Unigram": 120,
    "Bigram": 75,
    "Trigram": 55,
    "Interpolation": 48
}

print("\nMODEL COMPARISON")

for model, perplexity in results.items():
    print(model, "Perplexity:", perplexity)

best_model = min(results, key=results.get)

print("\nRecommended Language Model:", best_model)

print("Recommended POS Tagger: HMM")

print("\nReasons:")
print("1. Uses transition probabilities.")
print("2. Uses emission probabilities.")
print("3. Handles sequence-based tagging.")
print("4. Can be extended for unknown words.")

print("\nLimitations:")
print("1. Unknown words.")
print("2. Code-mixed language.")
print("3. Domain-specific vocabulary.")
